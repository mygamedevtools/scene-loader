<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="OperationHud.uss" />

    <!--
        Lives in a scene that is never unloaded, so it watches every transition from start to
        finish. picking-mode="Ignore" on the root: it spans the screen, and without it the
        examples list underneath would stop receiving clicks.
    -->
    <ui:VisualElement name="hud" class="screen hud" picking-mode="Ignore">
        <ui:VisualElement name="panel" class="panel hud__panel">

            <ui:VisualElement class="hud__scene">
                <ui:Label text="ACTIVE SCENE" class="hud__caption" />
                <ui:VisualElement class="hud__scene-row">
                    <ui:VisualElement name="dot" class="hud__dot" />
                    <ui:Label name="scene-name" text="—" class="hud__scene-name" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="hud__op">
                <ui:VisualElement class="hud__op-head">
                    <ui:Label name="kind" text="No operation running" class="hud__idle" />
                    <ui:Label name="pct" text="" class="hud__pct" />
                    <ui:Button name="cancel" text="Cancel" class="hud__cancel" />
                </ui:VisualElement>
                <ui:VisualElement name="phases" class="hud__phases" />
                <ui:VisualElement class="hud__track">
                    <ui:VisualElement name="fill" class="hud__fill" />
                </ui:VisualElement>
            </ui:VisualElement>

        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
